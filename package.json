{
  "name": "multiplayer-game",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:client": "npm run build --workspace=client",
    "tunnel:serve": "npm run start --workspace=server",
    "tunnel:open": "npm run tunnel --workspace=server",
    "tunnel:cf": "node scripts/tunnel-cf.cjs",
    "tunnel:all": "npm run build:client && concurrently -k -n server,tunnel -c blue,magenta \"npm run tunnel:serve\" \"wait-on http://127.0.0.1:2567 && npm run tunnel:cf\"",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wait-on": "^8.0.1"
  }
}
